{
  "name": "obsidian-vault-code",
  "version": "2.0.8",
  "description": "Turn your vault into a lightweight IDE and code editor. Reveal hidden dotfiles, edit code across most programming languages, live-preview HTML, SVG, and MJML, and search and replace with zero bloat.",
  "main": "main.js",
  "type": "module",
  "author": "SPACESODA",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src/",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git tag -d v$npm_package_version && git tag $npm_package_version"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "code-editor",
    "ide",
    "dotfiles",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SPACESODA/obsidian-vault-code.git"
  },
  "bugs": {
    "url": "https://github.com/SPACESODA/obsidian-vault-code/issues"
  },
  "homepage": "https://github.com/SPACESODA/obsidian-vault-code#readme",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^9.22.0",
    "@eslint/json": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "esbuild": "0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.5.0",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.2"
  },
  "overrides": {
    "moment": "^2.31.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "mjml-browser": "^5.4.1",
    "obsidian": "latest"
  }
}
