{
  "name": "obsidian-vault-code",
  "version": "2.0.0",
  "description": "Turn your vault into a lightweight IDE and code editor. Reveal hidden dotfiles, edit 70+ programming languages, live-preview HTML & SVG, and search & replace with zero bloat.",
  "main": "main.js",
  "type": "module",
  "author": "SPACESODA",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src/",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git tag -d v$npm_package_version && git tag $npm_package_version"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "esbuild": "0.25.5",
    "eslint": "^10.2.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.5.0",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.2"
  },
  "dependencies": {
    "obsidian": "latest"
  }
}
